{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VTK Ontology DSL",
  "scopeName": "source.dsl",
  "patterns": [
    { "include": "#label-binding" },
    { "include": "#to-binding" },
    { "include": "#the-binding" },
    { "include": "#string-single" },
    { "include": "#string-double" },
    { "include": "#array-literal" },
    { "include": "#property-introducer" },
    { "include": "#with-bare" },
    { "include": "#verb" },
    { "include": "#noun" },
    { "include": "#connector" },
    { "include": "#number" }
  ],
  "repository": {
    "verb": {
      "comment": "DSL verb followed by noun — verb (red) + noun (purple)",
      "match": "\\b(create|define|add|apply|fashion|forge|launch|load|read|write|save|show|build|use|generate|declare)\\s+([a-z_][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.dsl" },
        "2": { "name": "entity.name.type.dsl" }
      }
    },
    "noun": {
      "comment": "Standalone verb (when no noun follows, e.g. at end of line)",
      "match": "\\b(create|define|add|apply|fashion|forge|launch|load|read|write|save|show|build|use|generate|declare)\\b",
      "name": "keyword.control.dsl"
    },
    "property-introducer": {
      "comment": "Property introducer 'with' followed by property name (orange + green)",
      "match": "\\b(with)\\s+([a-z_][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.operator.with.dsl" },
        "2": { "name": "entity.name.tag.dsl" }
      }
    },
    "with-bare": {
      "comment": "Bare 'with' at end of line or before non-property token (orange)",
      "match": "\\bwith\\b",
      "name": "keyword.operator.with.dsl"
    },
    "label-binding": {
      "comment": "Label after 'called' — label is plain/black",
      "match": "\\b(called)\\s+([a-z_][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.called.dsl" },
        "2": { "name": "variable.other.label.dsl" }
      }
    },
    "to-binding": {
      "comment": "Source ref after 'to' — label is plain/black",
      "match": "\\b(to)\\s+([a-z_][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.connector.dsl" },
        "2": { "name": "variable.other.label.dsl" }
      }
    },
    "the-binding": {
      "comment": "Source ref after 'the' — label is plain/black",
      "match": "\\b(the)\\s+([a-z_][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.connector.dsl" },
        "2": { "name": "variable.other.label.dsl" }
      }
    },
    "connector": {
      "comment": "DSL connectors — structural keywords (grey/dim)",
      "match": "\\b(from|and|to|the)\\b",
      "name": "keyword.other.connector.dsl"
    },
    "string-single": {
      "comment": "String literals (blue, same as numbers/arrays)",
      "match": "'[^']*'",
      "name": "constant.other.string.dsl"
    },
    "string-double": {
      "comment": "String literals (blue, same as numbers/arrays)",
      "match": "\"[^\"]*\"",
      "name": "constant.other.string.dsl"
    },
    "array-literal": {
      "comment": "Array literals (blue)",
      "match": "\\[[^\\]]*\\]",
      "name": "constant.other.array.dsl"
    },
    "number": {
      "comment": "Numeric literals (blue)",
      "match": "\\b-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.dsl"
    }
  }
}
