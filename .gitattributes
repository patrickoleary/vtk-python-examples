# Git LFS — binary example assets
docs/public/examples/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/public/examples/**/*.jpg filter=lfs diff=lfs merge=lfs -text
docs/public/examples/**/*.jpeg filter=lfs diff=lfs merge=lfs -text

# All shared datasets under examples/data/ (vtk, vtu, vtp, dcm, case, gltf,
# bin, stl, geo, and extensionless data files) go to LFS
docs/public/examples/data/** filter=lfs diff=lfs merge=lfs -text
